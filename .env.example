# Growth OS Environment Variables
# Copy to .env and fill in real values

# === Supabase (Required) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# === AI (Platform-level, shared across tenants) ===
ANTHROPIC_API_KEY=your-anthropic-key
GOOGLE_API_KEY=your-google-api-key

# Gmail OAuth — TWO clients (see docs/business/runbooks/connect-personal-gmail.md)
#   internal: the Workspace-only Cloud project. Only @firstgenautomate.com can
#             authorize it. Powers the drip reply-sync + the work inbox scan.
#   external: a SECOND Cloud project, consent screen External, published to
#             production. The only way a personal @gmail.com can authorize
#             (the internal one returns `403 org_internal`). Optional — leave
#             unset and the personal-Gmail button simply doesn't appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EXTERNAL_CLIENT_ID=
GOOGLE_EXTERNAL_CLIENT_SECRET=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# === Search & Enrichment (Platform-level) ===
SERPER_API_KEY=your-serper-key
APOLLO_API_KEY=your-apollo-key
HUNTER_API_KEY=your-hunter-key

# === Server ===
API_PORT=3000
WORKER_PORT=3001
API_URL=http://localhost:3000
NODE_ENV=development

# === Stripe (Payment Processing) ===
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_GROWTH=price_your-growth-tier-price-id
STRIPE_PRICE_SCALE=price_your-scale-tier-price-id
STRIPE_PRICE_SETUP=price_your-setup-fee-price-id

# === AI Safety System (Release 1 = monitoring only) ===
# SAFE-DEFAULT CONTRACT: observability defaults ON, every enforcement lever
# defaults OFF. A missing var NEVER blocks live traffic. Leave the enforcement
# flags unset/false until the rollout plan advances with explicit approval.
#
# Observability (default ON — omit to keep on):
AI_USAGE_TRACKING_ENABLED=true
AI_MONITOR_MODE_ENABLED=true
AI_ALERTS_ENABLED=true
# Enforcement (default OFF — keep false for Release 1):
AI_HARD_LIMITS_ENABLED=false
AI_CIRCUIT_BREAKER_ENABLED=false
AI_QUEUE_LIMITS_ENABLED=false
AI_IDEMPOTENCY_ENFORCEMENT=false
AI_STRICT_METADATA_REQUIRED=false
AI_DISTRIBUTED_RATE_LIMIT_ENABLED=false
AI_PROVIDER_KILL_SWITCH_ENABLED=false
AI_AGENT_KILL_SWITCH_ENABLED=false
AI_COST_ENFORCEMENT_ENABLED=false
AI_MANUAL_BATCH_APPROVAL_ENABLED=false
# Thresholds (evaluated in monitor mode; tune freely):
AI_MAX_CALLS_PER_TENANT_PER_MINUTE=10
AI_MAX_CALLS_PER_TENANT_PER_HOUR=100
AI_MAX_CALLS_PER_TENANT_PER_DAY=500
AI_MAX_CALLS_PER_AGENT_PER_HOUR=50
AI_MAX_CALLS_PER_AGENT_PER_DAY=250
AI_MAX_CALLS_PER_JOB=3
AI_MAX_AGENT_LOOP_ITERATIONS=5
AI_MAX_PROVIDER_ATTEMPTS_PER_OPERATION=3
AI_MAX_NEW_OUTREACH_JOBS_PER_TENANT_PER_HOUR=25
AI_MAX_PENDING_OUTREACH_JOBS_PER_TENANT=50
AI_COST_WARNING_PERCENT=50
AI_COST_ALERT_PERCENT=75
AI_COST_PAUSE_PERCENT=90
AI_COST_HARD_STOP_PERCENT=100
AI_BATCH_APPROVAL_THRESHOLD=20
AI_DAILY_BUDGET_USD=0
AI_ALERT_COOLDOWN_MIN=60
# Pace gate (in-process request smoothing for Claude; ms between call starts):
CLAUDE_MIN_CALL_INTERVAL_MS=1200
# Two-service deploy guard (set false on the SECONDARY Railway service to stop
# duplicate cron + double job processing):
SCHEDULER_ENABLED=true
JOB_PROCESSOR_ENABLED=true
